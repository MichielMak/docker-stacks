#!/bin/sh
# "git push" goes through git-push-verified, so pushed commits are Verified, but only where the bot
# config is active (claude-github-app.enabled, see ../gitconfig); elsewhere it's a plain push.
# git-push-verified hands anything it can't do (tags, refspecs, --delete, ...) to the real git push.
if [ "${1:-}" = push ] && [ "$(/usr/bin/git config --bool claude-github-app.enabled 2>/dev/null)" = true ]; then
  shift
  exec "$(dirname "$0")/git-push-verified" --from-git-push "$@"
fi
exec /usr/bin/git "$@"
