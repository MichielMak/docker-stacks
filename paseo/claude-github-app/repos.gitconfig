# Repos whose agents commit and push as michiel-claude[bot] (the repos the App is installed on).
# Included from ~/.gitconfig in containers where the bot is opt-in per repo (OpenChamber); other repos
# use the user's own identity. One line per URL form, as hasconfig patterns are plain globs.
# Keep in sync with the App's repository access.
[includeIf "hasconfig:remote.*.url:https://github.com/MichielMak/docker-stacks"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/MichielMak/docker-stacks.git"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:MichielMak/docker-stacks"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:MichielMak/docker-stacks.git"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/MichielMak/docker-stacks"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/MichielMak/docker-stacks.git"]
	path = /opt/claude-github-app/gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/MichielMak/AI"]
