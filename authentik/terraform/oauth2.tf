  }

  default_grant_types = ["authorization_code", "hybrid", "implicit", "client_credentials", "password", "urn:ietf:params:oauth:grant-type:device_code", "refresh_token"]
}

resource "authentik_provider_oauth2" "app" {
  for_each = local.oauth2

  name                = each.value.name
  client_id           = each.value.client_id
  client_type         = try(each.value.client_type, "confidential")
  authorization_flow  = try(each.value.implicit_consent, false) ? data.authentik_flow.implicit_consent.id : data.authentik_flow.explicit_consent.id
  authentication_flow = try(each.value.login_flow, false) ? data.authentik_flow.default_authentication.id : ""
  invalidation_flow   = data.authentik_flow.provider_invalidation.id

  allowed_redirect_uris = [for r in each.value.redirects : {
    url               = r.url
    matching_mode     = try(r.mode, "strict")
    redirect_uri_type = "authorization"
  }]

  property_mappings        = [for s in try(each.value.scopes, ["openid", "profile", "email"]) : local.scopes[s]]
  sub_mode                 = try(each.value.sub_mode, "hashed_user_id")
  grant_types              = try(each.value.grant_types, local.default_grant_types)
  jwt_federation_sources   = try(each.value.federate_google, false) ? [local.google_source_id] : []
  jwt_federation_providers = []

  signing_key                = data.authentik_certificate_key_pair.self_signed.id
  encryption_key             = try(each.value.encrypt_tokens, false) ? data.authentik_certificate_key_pair.self_signed.id : ""
  include_claims_in_id_token = try(each.value.claims_in_id_token, true)
  issuer_mode                = "per_provider"
  logout_method              = "backchannel"
  logout_uri                 = ""

  access_code_validity    = "minutes=1"
  access_token_validity   = "minutes=5"
  refresh_token_validity  = "days=30"
  refresh_token_threshold = try(each.value.refresh_token_threshold, "seconds=0")
}
