    }
    komodo = {
      name            = "Provider for komodo"
      client_id       = "u0TOzsrPhw4kbPsfpHM5UU2VrjdmcCWW8pzqBSzl"
      redirects       = [{ url = "https://komodo.makstra.nl/auth/oidc/callback" }]
      federate_google = true
      scopes          = ["openid", "preferred_username", "profile", "email"]
