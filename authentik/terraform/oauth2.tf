# OAuth2/OIDC providers, keyed by the application slug they belong to (owncloud-* have no application).
#
# Each entry needs name, client_id and redirects. Everything else is optional; leave it out for the default:
#   client_type     = "confidential" | "public"                 (default "confidential")
#   implicit_consent = true   skip the consent screen           (default: ask once)
#   login_flow      = true    use default-authentication-flow   (default: the brand's flow)
#   scopes          = keys of local.scopes                      (default ["openid", "profile", "email"])
#   sub_mode        = what the `sub` claim holds                (default "hashed_user_id")
#   federate_google = true    accept Google-issued tokens
#   redirects       = [{ url = "...", mode = "regex" }]          (mode defaults to "strict")
#
# The client secret is generated by Authentik and never written here. Read it in the admin UI.

locals {
  oauth2 = {
    audiobookshelf = {
      name               = "audiobookshelf"
      client_id          = "hsdAtuiuwtvPIBcBKglzAkfUpa0ruOpGcNoxKAPG"
      redirects          = [{ url = "https://audiobookshelf.makstra.nl/auth/openid/callback" }]
      login_flow         = true
      sub_mode           = "user_username"
      claims_in_id_token = false
    }
    bambuddy = {
      name                    = "Provider for bambuddy"
      client_id               = "wXjNryG47cy4EXFjnRh8mXjGjtCg0BvrIPWCfsUr"
      redirects               = [{ url = "https://bambuddy.makstra.nl/api/v1/auth/oidc/callback" }]
      refresh_token_threshold = "hours=1"
    }
    booklore = {
      name            = "Provider for booklore"
      client_id       = "hupXoSCY25hFOYwNgTMi2vNJbCHT9aMmqkl2sMwu"
      client_type     = "public"
      federate_google = true
      scopes          = ["openid", "profile", "offline_access", "email"]
      redirects = [
        { url = "https://booklore.makstra.nl/oauth2-callback" },
        { url = "https://booklore.makstra.nl/*", mode = "regex" },
