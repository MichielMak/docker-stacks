{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>MichielMak/renovate-config"
  ],
  "dependencyDashboard": {
    "title": "Renovate Dependency Dashboard Michiel",
    "header": "This issue contains a list of Renovate updates and statuses.",
    "autoclose": false
  },
  "assigneesFromCodeOwners": true,
  "assignAutomerge": true,
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "pip_requirements",
    "github-actions",
    "terraform",
    "pre-commit",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "ignoreUnstable": true,
  "pinDigests": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeSchedule": ["* 0-6 * * *"],
  "pruneStaleBranches": true,
  "recreateWhen": "always",
  "branchConcurrentLimit": 10,
  "gitIgnoredAuthors": [
    "self-hosted-renovate-mm"
  ],
  "packageRules": [
    {
      "description": "Automerge minor, patch and digest updates; majors wait for review. Renovate merges the PR itself (platformAutomerge off) once every check is green, and only 00:00-07:00 (automergeSchedule), since every merge deploys. Must stay first so later automerge: false rules win.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Core stacks need manual review: if one breaks overnight, everything behind it is down until morning",
      "matchFileNames": [
        "traefik/**",
        "cloudflared/**",
        "authentik/**",
        "pihole/**"
      ],
      "automerge": false
    },
    {
      "description": "Group arl-sentinel pip deps with its Docker stack",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["arl-sentinel/app/requirements.txt"],
      "groupName": "stack: arl-sentinel",
      "groupSlug": "stack-arl-sentinel"
    },
    {
      "description": "Disable playwright auto-updates (version must match runtime browser binaries)",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["playwright"],
      "enabled": false
    },
    {
      "description": "Docker: allow only stable SemVer or CalVer",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "/^(?:\\d+\\.\\d+\\.\\d+(?:[-._][A-Za-z0-9]+)?|20\\d{2}\\.\\d{1,2}(?:\\.\\d+)?)$/i"
    },
    {
      "description": "Docker: reject prereleases globally",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "!/(alpha|beta|rc|canary|nightly|snapshot|preview|experimental|dev)/i"
    },
    {
      "description": "Docker: reject hash-only and channel tags",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "!/^(?:latest|stable|edge|release|rolling|master|main)$|^[a-f0-9]{7,}$/i"
    },
    {
      "description": "headless-shell: track the stable channel by digest — its version tags mix stable/beta/dev builds (must stay after the global Docker tag rules)",
      "matchPackageNames": [
        "chromedp/headless-shell"
      ],
      "allowedVersions": "/^stable$/"
    },
    {
      "description": "Hotio: parse release-/pr-plugins- <semver> tags",
      "matchPackageNames": [
        "/^ghcr\\.io\\/hotio\\//"
      ],
      "versioning": "regex:^(?:release-|pr-plugins-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$"
    },
    {
      "description": "Euro-Office: only v<semver> releases (registry also holds branch/buildcache tags)",
      "matchPackageNames": [
        "ghcr.io/euro-office/documentserver"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "BamBuddy: parse a.b.c.d versioning",
      "matchPackageNames": [
        "/^(?:docker\\.io\\/)?maziggy\\/bambuddy$/"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?$/"
    },
    {
      "description": "Spotweb: parse YYYYMMDD date tags (overrides the global hash-only rejection, since 8 digits also look like hex)",
      "matchPackageNames": [
        "/^(?:docker\\.io\\/)?jgeusebroek\\/spotweb$/"
      ],
      "versioning": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
      "allowedVersions": "/^20\\d{6}$/"
    },
    {
      "description": "Lidarr: only use pr-plugins branch",
      "matchPackageNames": [
        "ghcr.io/hotio/lidarr"
      ],
      "allowedVersions": "/^pr-plugins-/"
    },
    {
      "description": "Authentik: PG16 data directory — never bump major",
      "matchFileNames": [
        "**/authentik/compose.yaml",
        "**/authentik/compose.yml",
        "**/authentik/docker-compose.yaml",
        "**/authentik/docker-compose.yml"
      ],
      "matchPackageNames": [
        "/^(?:docker\\.io\\/library\\/)?postgres$/"
      ],
      "allowedVersions": "/^16(?:\\.\\d+){0,2}(?:-[A-Za-z0-9.-]+)?$/"
    },
    {
      "description": "Postgres majors need manual review — the data directory is not backward compatible",
      "matchPackageNames": [
        "/^(?:docker\\.io\\/library\\/)?postgres$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "MongoDB majors need manual review — featureCompatibilityVersion must be raised first and downgrades are not possible",
      "matchPackageNames": [
        "/^(?:docker\\.io\\/library\\/)?mongo$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "OpenCode majors need manual review — OpenChamber only supports OpenCode 2.x",
      "matchPackageNames": [
        "@opencode/cli"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "MariaDB: stay on the 12.3 LTS line — 13.x is a rolling release and data directories cannot be downgraded. RomM is already on 13.x.",
      "matchFileNames": [
        "!**/romm/compose.yaml"
      ],
      "matchPackageNames": [
        "/^(?:docker\\.io\\/library\\/)?mariadb$/"
      ],
      "allowedVersions": "/^12\\.3\\.\\d+$/"
    },
    {
      "description": "Immich Infrastructure: Ignore PostgreSQL updates",
      "matchFileNames": [
        "**/immich-app/compose.yaml",
        "**/immich-app/compose.yml",
        "**/immich-app/docker-compose.yaml",
        "**/immich-app/docker-compose.yml"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/immich-app\\/postgres/"
      ],
      "enabled": false
    },
    {
      "description": "Immich Valkey/Redis: allow minor/patch, majors need approval",
      "matchFileNames": [
        "**/immich-app/compose.yaml",
        "**/immich-app/compose.yml",
        "**/immich-app/docker-compose.yaml",
        "**/immich-app/docker-compose.yml"
      ],
      "matchPackageNames": [
        "/^docker\\.io\\/valkey\\//",
        "/^docker\\.io\\/redis\\//"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Immich Apps: server and machine-learning must stay on the same version, so only open a PR once both have an update",
      "matchFileNames": [
        "**/immich-app/compose.yaml",
        "**/immich-app/compose.yml",
        "**/immich-app/docker-compose.yaml",
        "**/immich-app/docker-compose.yml"
      ],
      "matchPackageNames": [
        "/^(?:docker\\.io\\/)?altran1502\\/immich-server/",
        "/^(?:docker\\.io\\/)?altran1502\\/immich-machine-learning/"
      ],
      "groupName": "immich-apps",
      "groupSlug": "immich-apps",
      "minimumGroupSize": 2,
      "addLabels": [
        "immich-apps"
      ]
    },
    {
      "description": "Group updates strictly per compose file directory",
      "matchManagers": [
        "docker-compose"
      ],
      "matchFileNames": [
        "**/compose.yaml",
        "**/compose.yml",
        "**/docker-compose.yaml",
        "**/docker-compose.yml"
      ],
      "groupName": "stack: {{parentDir}}",
      "groupSlug": "stack-{{parentDir}}",
      "addLabels": [
        "stack:{{parentDir}}"
      ],
      "matchPackageNames": [
        "!/^ghcr\\.io\\/immich-app\\/postgres/",
        "!/^(?:docker\\.io\\/)?altran1502\\/immich-server/",
        "!/^(?:docker\\.io\\/)?altran1502\\/immich-machine-learning/"
      ]
    },
    {
      "description": "Periphery Dockerfile ships in the same PR as the komodo stack (core and periphery must match)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "komodo/periphery.Dockerfile"
      ],
      "groupName": "stack: komodo",
      "groupSlug": "stack-komodo",
      "addLabels": [
        "stack:komodo"
      ]
    },
    {
      "description": "Socket proxy sidecars live in many stacks: bump them all in one PR (must stay after the per-stack grouping rule)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(?:docker\\.io\\/)?linuxserver\\/socket-proxy$/",
        "/^lscr\\.io\\/linuxserver\\/socket-proxy$/"
      ],
      "groupName": "linuxserver/socket-proxy (all stacks)",
      "groupSlug": "socket-proxy",
      "addLabels": [
        "socket-proxy"
      ]
    },
    {
      "description": "Minimum release age for Docker to avoid fresh-tag churn",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAge": "12 hours",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Open PRs immediately for digest/minor/patch; majors stay separate",
      "matchDatasources": [
        "docker"
      ],
      "separateMajorMinor": true
    },
    {
      "description": "Swap floating docker tags to numbered tags (SemVer or CalVer) when available",
      "matchDatasources": [
        "docker"
      ],
      "matchCurrentVersion": "/^(latest|stable|release|edge)$/i",
      "rangeStrategy": "replace",
      "allowedVersions": "/^(?:\\d+(?:\\.\\d+){1,2}(?:[-._][A-Za-z0-9]+)?)|(20\\d{2}\\.\\d{1,2}(?:\\.\\d+)?)$/",
      "versioning": "loose"
    },
    {
      "description": "Skip digest-only updates for versioned images — version bumps already bundle the new digest",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "matchCurrentVersion": "!/^(latest|stable|edge|release|rolling|master|main)$/i",
      "enabled": false
    },
    {
      "description": "LinuxServer.io re-points its short version tags on every rebuild (-lsNNN), so digest-only updates must stay enabled",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(?:docker\\.io\\/)?linuxserver\\//",
        "/^lscr\\.io\\/linuxserver\\//"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": true
    },
    {
      "description": "Label pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "pre-commit"
      ]
    },
    {
      "description": "The pre-commit manager cannot write a digest into rev:, so pinning fails with 'update failure'",
      "matchManagers": [
        "pre-commit"
      ],
      "pinDigests": false
    },
    {
      "description": "OpenTofu (cloudflare/): merging applies to the live Cloudflare config, so review these by hand",
      "matchFileNames": ["cloudflare/**", ".github/workflows/cloudflare.yml"],
      "matchPackageNames": ["cloudflare/cloudflare", "opentofu/opentofu"],
      "groupName": "opentofu cloudflare",
      "groupSlug": "opentofu-cloudflare",
      "automerge": false
    },
    {
      "description": "OpenTofu release tags have a v prefix; TOFU_VERSION does not",
      "matchPackageNames": ["opentofu/opentofu"],
      "extractVersion": "^v(?<version>.+)$"
    }
  ],
  "customManagers": [
    {
      "description": "Pick up versions pinned via a '# renovate:' annotation comment (compose env vars, Cloudflare workflow)",
      "customType": "regex",
      "managerFilePatterns": [
        "/compose\\.ya?ml$/",
        "/^\\.github/workflows/cloudflare\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*-?\\s*\\w+?_VERSION\\s*[:=]\\s*(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "customDatasources": {
    "twg": {
      "description": "Atlassian Teamwork Graph CLI: the CDN manifest lists the latest stable release",
      "defaultRegistryUrlTemplate": "https://teamwork-graph.atlassian.com/cli/manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": version, \"releaseTimestamp\": publishedAt}], \"changelogUrl\": releaseNotesUrl, \"homepage\": installPageUrl}"
      ]
    }
  },
  "hostRules": [
    {
      "matchHost": "lscr.io",
      "hostType": "docker",
      "timeout": 120000
    },
    {
      "matchHost": "registry-1.docker.io",
      "hostType": "docker",
      "timeout": 120000
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "timeout": 120000
    }
  ]
}
